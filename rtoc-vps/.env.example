# Copy this file to .env and fill in the values. NEVER commit .env.

# REQUIRED - Neon connection string (Neon dashboard -> Connect)
DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require

# REQUIRED - at least 32 characters. Generate with: openssl rand -hex 32
JWT_SECRET=

# OPTIONAL - secret typed into the "Role code" box on the Register screen to
# create an admin account. Leave empty to disable admin registration entirely.
ADMIN_REGISTRATION_CODE=

# OPTIONAL - defaults shown. Keep HOST as 127.0.0.1 so only nginx can reach the app.
PORT=3000
HOST=127.0.0.1

# Brevo email (for password reset)
BREVO_SMTP_HOST=smtp-relay.brevo.com
BREVO_SMTP_PORT=587
BREVO_SMTP_USER=your@email.com
BREVO_SMTP_PASS=your_smtp_password
BREVO_FROM_EMAIL=noreply@yourdomain.com
APP_URL=https://yourdomain.com
